# Copier en `.env.local` (jamais commité). Ces deux valeurs sont publiques par
# conception : elles identifient le projet, et c'est RLS qui protège les données.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Uniquement côté serveur, pour les routines qui contournent RLS (semis, purge
# planifiée). Jamais préfixée NEXT_PUBLIC_ : elle n'a rien à faire dans un
# paquet navigateur. À poser dans Vercel, pas ici.
# SUPABASE_SERVICE_ROLE_KEY=
